<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Jediné místo, kde se verze a autorství udržují. Odsud je dědí AssemblyVersion,
       FileVersion i InformationalVersion, takže sedí v UI i ve vlastnostech souboru .exe. -->
  <PropertyGroup>
    <VersionPrefix>0.13.0</VersionPrefix>
    <Product>Battlegrounds Tracker</Product>
    <Authors>Michal Jašek</Authors>
    <Company>Michal Jašek</Company>
    <Copyright>© 2026 Michal Jašek</Copyright>
  </PropertyGroup>

  <!--
    Každý build, který neprošel vydáním, se označí jako 0.13.0-dev. Podmínka je na Version,
    ne na Configuration, a to záměrně: Configuration tady ještě nemusí být dosazená, protože
    Directory.Build.props se vyhodnocuje před výchozími hodnotami SDK. Build bez -c pak značku
    nedostal a tvářil se jako vydaná verze. Version naopak zadává jen vydání
    (`dotnet publish -p:Version=…` v release.yml), takže se jako vydané nemůže označit nic,
    co vydáním neprošlo — ani Release build ze stroje.
  -->
  <PropertyGroup Condition="'$(Version)' == ''">
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>
</Project>
