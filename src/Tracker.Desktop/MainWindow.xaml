<Window x:Class="Tracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battlegrounds Tracker Overlay" Icon="Assets/bg-tracker.ico" Width="380" Height="720"
        MinWidth="228" MinHeight="26" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        SizeChanged="Window_SizeChanged" LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <!-- Kartička minionu ve stylu hry, ukazuje se v podoknech po najetí myší. Portrét je
             vystřižený do oválu s prstencem, pod ním jmenná páska, rámeček s popisem, páska
             s typem a v dolních rozích drahokamy s útokem a životem. -->
        <DataTemplate x:Key="MinionCardTemplate">
            <Grid Width="148" Height="214" Margin="0,0,8,9" Background="Transparent">
                <Border CornerRadius="9" Background="#D60A1018" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2E3D52" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                    <Setter Property="BorderBrush" Value="#7A5A1E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Border VerticalAlignment="Top" Margin="8,113,8,0" Height="74" CornerRadius="5"
                        Background="#DE060B14" BorderBrush="#33455C" BorderThickness="1">
                    <StackPanel Margin="6,4,6,4">
                        <TextBlock Text="{Binding Keywords}" FontSize="8" FontWeight="Bold"
                                   Foreground="#E0B24A" TextWrapping="Wrap" MaxHeight="20"
                                   LineHeight="10" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                   Visibility="{Binding HasKeywords, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Card.Text}" FontSize="8.5" Foreground="#D6DEEA"
                                   TextWrapping="Wrap" LineHeight="11" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Card.HasText, Converter={StaticResource BoolToVisibility},
                                                        FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <Grid Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0">
                    <Ellipse Fill="#0C121C" />
                    <!-- Kresba se dá v nastavení vypnout; pak zůstane jen tmavý ovál. -->
                    <Ellipse Visibility="{DynamicResource CardArtVisibility}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Card.Image}" Stretch="UniformToFill"
                                        Viewbox="0.13,0.09,0.74,0.74" ViewboxUnits="RelativeToBoundingBox" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse StrokeThickness="3.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Stroke">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                            <GradientStop Color="#C9D6E6" Offset="0" />
                                            <GradientStop Color="#6C7E96" Offset="0.5" />
                                            <GradientStop Color="#39485E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                        <Setter Property="Stroke">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                                    <GradientStop Color="#FBE9A8" Offset="0" />
                                                    <GradientStop Color="#D9A63C" Offset="0.5" />
                                                    <GradientStop Color="#8A661C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <Border Width="27" Height="29" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0"
                        Background="#A8156A" BorderBrush="#E8C87A" BorderThickness="1.5"
                        CornerRadius="4,4,12,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tier}" FontSize="12" FontWeight="Bold" Foreground="#FFF2CE" />
                        <TextBlock Text="★" FontSize="7" Foreground="#FFF2CE" Margin="1,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="★" FontSize="15" FontWeight="Bold" Foreground="#F4D06F"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                           Visibility="{Binding IsGolden, Converter={StaticResource BoolToVisibility}}" />

                <Border VerticalAlignment="Top" Margin="6,94,6,0" Height="23" CornerRadius="3"
                        Background="#F0231A12" BorderBrush="#7A6238" BorderThickness="1" Padding="5,0">
                    <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="Bold" Foreground="#F7EFDD"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="21" LineHeight="10"
                               LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,179,0,0"
                        Background="#F02A2114" BorderBrush="#7A6238" BorderThickness="1"
                        CornerRadius="3" Padding="7,0,7,1" MaxWidth="86"
                        Visibility="{Binding HasRace, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Race}" FontSize="8.5" Foreground="#E4D8BE"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Grid Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,1">
                    <Ellipse Stroke="#6B4E17" StrokeThickness="1.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#F6D072" Offset="0" />
                                <GradientStop Color="#C68C22" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="6,9,6,9">
                        <TextBlock Text="{Binding Attack}" FontWeight="Bold" Foreground="#2A1B02" />
                    </Viewbox>
                </Grid>
                <Grid Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1">
                    <Ellipse Stroke="#5E1A16" StrokeThickness="1.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#F08078" Offset="0" />
                                <GradientStop Color="#A82A22" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="6,9,6,9">
                        <TextBlock Text="{Binding Health}" FontWeight="Bold" Foreground="#FFF1EE" />
                    </Viewbox>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="MinionCardsStyle" TargetType="ItemsControl">
            <Setter Property="MaxWidth" Value="1094" />
            <Setter Property="ItemTemplate" Value="{StaticResource MinionCardTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Řádek minionu na desce, v nabídce nebo v ruce. Seznam nescrolluje a rezervuje si
             místo na sedm minionů, aby okno při změně počtu neposkakovalo. -->
        <Style x:Key="MinionListStyle" TargetType="ItemsControl">
            <Setter Property="MinHeight" Value="105" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Height="15" Background="Transparent"
                              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="120000"
                              ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6">
                            <Grid.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MinionCardTemplate}">
                                            <ContentPresenter.LayoutTransform>
                                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text2}"
                                                   FontSize="11" MaxWidth="236" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="11" />
                                <ColumnDefinition Width="Auto" MaxWidth="150" SharedSizeGroup="MinionName" />
                                <ColumnDefinition Width="Auto" MaxWidth="110" SharedSizeGroup="MinionKeywords" />
                                <ColumnDefinition Width="*" MinWidth="4" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" Foreground="{DynamicResource Brush.Text3}" FontSize="8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="★" Foreground="{DynamicResource Brush.Gold}" FontSize="8.5" Margin="0,0,3,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsGolden, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Keywords}" Foreground="{DynamicResource Brush.Text3}" FontSize="8"
                                       Margin="6,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding TeammateHint}" Foreground="{DynamicResource Brush.Teammate}" FontSize="8"
                                       Margin="6,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasTeammateHint, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="⚔" FontSize="8" Foreground="{DynamicResource Brush.Gold}" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Attack}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB51;" Style="{StaticResource GlyphStyle}" FontSize="7" Foreground="{DynamicResource Brush.Health}" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding Health}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Health}" />
                            </StackPanel>
                            <TextBlock Grid.Column="6" Text="{Binding Tier}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Řádek panelu s detaily: štítek vlevo, hodnota vpravo, hodnoty zarovnané pod sebou. -->
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="DetailStrongValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="DetailRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="DetailPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Panel s detaily: bonusy pro celou hru, bonusy na kartách, trinkety a ekonomika krčmy.
             Jedna šablona pro obě umístění, vpravo i pod hlavním sloupcem. -->
        <DataTemplate x:Key="DetailsTemplate">
            <StackPanel>
                <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="BONUSY PRO CELOU HRU" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#7EA8E0" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Tavern kouzla" Style="{StaticResource DetailLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SpellBuff}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSpellBuff}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#D06B6B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Blood gemy" Style="{StaticResource DetailLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding BloodGemBuff}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBloodGemBuff}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#E09A4A" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Elementálové" Style="{StaticResource DetailLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ElementalBuff}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasElementalBuff}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#6FBFA0" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Piráti" Style="{StaticResource DetailLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PirateBuff}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPirateBuff}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#A98FD3" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Undead (útok)" Style="{StaticResource DetailLabelStyle}"
                                           ToolTip="Nasčítaný útok, který mají undeadi navíc po celou hru" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding UndeadBuff}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUndeadBuff}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6"
                        Visibility="{Binding HasCardCounters, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="BONUSY NA KARTÁCH" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <ItemsControl ItemsSource="{Binding CardCounters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4" Background="Transparent"
                                          ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                                          ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6"
                                          ToolTipService.IsEnabled="{Binding Card.HasText, FallbackValue=False, TargetNullValue=False}">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <StackPanel MaxWidth="260">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Card.Text}" FontSize="11" Foreground="{DynamicResource Brush.Text2}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource DetailValueStyle}"
                                                   Foreground="{DynamicResource Brush.Gold}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="TRINKETY" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <Grid Margin="0,0,0,6" Background="Transparent"
                              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                              ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6"
                              ToolTipService.IsEnabled="{Binding LesserTrinketCard.HasText, FallbackValue=False, TargetNullValue=False}">
                            <Grid.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{Binding LesserTrinket}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LesserTrinketCard.Text}" FontSize="11" Foreground="{DynamicResource Brush.Text2}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Brush.Surface2}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE735;" FontSize="9">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLesserTrinket}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="MALÝ" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Text3}" />
                                <TextBlock Text="{Binding LesserTrinket}" FontSize="10" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLesserTrinket}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Grid Background="Transparent"
                              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                              ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6"
                              ToolTipService.IsEnabled="{Binding GreaterTrinketCard.HasText, FallbackValue=False, TargetNullValue=False}">
                            <Grid.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{Binding GreaterTrinket}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding GreaterTrinketCard.Text}" FontSize="11" Foreground="{DynamicResource Brush.Text2}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource Brush.Surface2}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE735;" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGreaterTrinket}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="VELKÝ" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Text3}" />
                                <TextBlock Text="{Binding GreaterTrinket}" FontSize="10" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasGreaterTrinket}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="EKONOMIKA KRČMY" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Zlato" Style="{StaticResource DetailLabelStyle}"
                                       ToolTip="Kolik zlata je k utracení a jaký je strop tohohle kola" />
                            <TextBlock Grid.Column="1" Text="{Binding GoldDetail}" Style="{StaticResource DetailStrongValueStyle}"
                                       Foreground="{DynamicResource Brush.Gold}" />
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Bonus toto kolo" Style="{StaticResource DetailLabelStyle}"
                                       ToolTip="Zlato nad strop kola, které přišlo z karet zahraných minule" />
                            <Border Grid.Column="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource DetailPillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTempGold}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.PositiveSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Positive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TempGold}" FontSize="9.5" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTempGold}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Positive}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Utraceno v kole" Style="{StaticResource DetailLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding GoldSpent}" Style="{StaticResource DetailStrongValueStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Cena rerollu" Style="{StaticResource DetailLabelStyle}"
                                       ToolTip="Kolik zlata stojí obnovení nabídky Boba. Při volném rerollu je nula." />
                            <TextBlock Grid.Column="1" Text="{Binding RefreshCost}" Style="{StaticResource DetailStrongValueStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}"
                              Visibility="{Binding HasFreeRefreshes, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Rerolly zdarma" Style="{StaticResource DetailLabelStyle}" Foreground="{DynamicResource Brush.Gold}"
                                       ToolTip="Kolik rerollů zbývá zdarma" />
                            <Border Grid.Column="1" Style="{StaticResource DetailPillStyle}" Background="{DynamicResource Brush.GoldSoft}"
                                    BorderBrush="{DynamicResource Brush.Gold}">
                                <TextBlock Text="{Binding FreeRefreshes}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Gold}" />
                            </Border>
                        </Grid>
                        <Grid Style="{StaticResource DetailRowStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Cena upgradu" Style="{StaticResource DetailLabelStyle}"
                                       ToolTip="Kolik zlata stojí posun na další tavern tier. Na posledním tieru je místo ceny „max“." />
                            <TextBlock Grid.Column="1" Text="{Binding UpgradeCost}" Style="{StaticResource DetailStrongValueStyle}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Bonus příští kolo" Style="{StaticResource DetailLabelStyle}"
                                       ToolTip="Zlato navíc na příští kolo z karet zahraných teď" />
                            <Border Grid.Column="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource DetailPillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasExtraGold}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.PositiveSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Positive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ExtraGold}" FontSize="9.5" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasExtraGold}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Positive}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Dlaždice přehledu: titulek a jedno číslo. -->
        <Style x:Key="StatTileStyle" TargetType="Border" BasedOn="{StaticResource SurfaceStyle}">
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <!-- Rozložení se sází v návrhových jednotkách a Viewbox ho škáluje na okno, takže overlay
         zabere stejný podíl obrazovky na FullHD i na 4K a nic se neořezává. -->
    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Border x:Name="RootCard" Width="380" Background="{DynamicResource Brush.Window}"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10"
                SizeChanged="RootCard_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hlavička: jediné místo, kterým se okno táhne. Ve sbaleném overlayi zůstane sama. -->
                <Border x:Name="HeaderCard" Background="{DynamicResource Brush.Header}" CornerRadius="9,9,0,0"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.AccentSoft}"
                                BorderBrush="{DynamicResource Brush.AccentBorder}" BorderThickness="1" VerticalAlignment="Center"
                                ToolTip="{Binding Diagnostics}">
                            <TextBlock Text="BG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TitleText" Text="Battlegrounds Tracker" FontSize="11.5" FontWeight="SemiBold"
                                           FontFamily="{StaticResource Font.Display}" VerticalAlignment="Center" />
                                <!-- Verze hned za názvem. Ladicí build se odliší barvou, aby se nedal
                                     splést s vydanou verzí. -->
                                <Border Margin="6,0,0,0" Padding="4,0" CornerRadius="3" VerticalAlignment="Center"
                                        Height="{Binding ActualHeight, ElementName=TitleText}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ChipStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDevelopmentBuild}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.GoldSoft}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Version, Mode=OneWay}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDevelopmentBuild}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Positive}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="9" Foreground="{DynamicResource Brush.Text2}" MaxWidth="190"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceTooltip}" VerticalAlignment="Center">
                                    <Run Text="{Binding ModeLabel, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding SourceDescription, Mode=OneWay}" />
                                </TextBlock>
                                <Border Style="{StaticResource ChipStyle}" Margin="6,0,0,0" Padding="4,0"
                                        Background="{DynamicResource Brush.OpponentSoft}" BorderBrush="{DynamicResource Brush.Opponent}"
                                        Visibility="{Binding IsDuos, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="DUOS" Style="{StaticResource ChipTextStyle}" FontSize="7.5"
                                               Foreground="{DynamicResource Brush.Opponent}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Click="SettingsButton_Click" ToolTip="Nastavení">
                                <TextBlock Text="&#xE713;" Style="{StaticResource GlyphStyle}" FontSize="12" />
                            </Button>
                            <Button x:Name="DetailsToggleButton" Style="{StaticResource IconButtonStyle}" Click="DetailsToggleButton_Click"
                                    ToolTip="Skrýt panel s detaily">
                                <TextBlock x:Name="DetailsToggleGlyph" Text="&#xE89F;" Style="{StaticResource GlyphStyle}" FontSize="12" />
                            </Button>
                            <Button x:Name="CollapseButton" Style="{StaticResource IconButtonStyle}" Click="CollapseButton_Click"
                                    ToolTip="Sbalit overlay">
                                <TextBlock x:Name="CollapseGlyph" Text="&#xE921;" Style="{StaticResource GlyphStyle}" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Ukončit tracker">
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource GlyphStyle}" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ContentPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- Sloupec s detaily. Šířka je v návrhových jednotkách; bez panelu je nula,
                             aby se karta zúžila zpátky na hlavní sloupec. -->
                        <ColumnDefinition x:Name="DetailsColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="10,8,10,8">
                        <!-- Přehled: kolo, místo, zlato, fáze. -->
                        <Grid Margin="0,0,0,6" Visibility="{Binding Settings.ShowStats, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="5" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="KOLO" Style="{StaticResource SectionTitleStyle}" FontSize="8" />
                                    <TextBlock Text="{Binding Turn}" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource Brush.Accent}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="MÍSTO" Style="{StaticResource SectionTitleStyle}" FontSize="8" />
                                    <TextBlock Text="{Binding Place}" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource Brush.Positive}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="ZLATO" Style="{StaticResource SectionTitleStyle}" FontSize="8" />
                                    <TextBlock Text="{Binding Gold}" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource Brush.Gold}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="FÁZE" Style="{StaticResource SectionTitleStyle}" FontSize="8" />
                                    <TextBlock Text="{Binding Phase}" Style="{StaticResource StatValueStyle}" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Lobby: další soupeř, typy v nabídce a tabulka osmi hráčů. -->
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6"
                                Visibility="{Binding Settings.ShowLobby, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="LobbyToggle" Style="{StaticResource SectionHeaderStyle}" IsChecked="True">
                                        <TextBlock Text="LOBBY" Style="{StaticResource SectionTitleStyle}" />
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1" Text="{Binding TavernUpgrade}" Style="{StaticResource MutedTextStyle}" FontSize="9" />
                                </Grid>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=LobbyToggle, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding NextOpponent}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Settings.ShowNextOpponent, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding AvailableRaces}" Style="{StaticResource MutedTextStyle}" FontSize="9.5" Margin="0,2,0,0"
                                               ToolTip="Typy minionů, které se v této lobby objevily v nabídce Boba"
                                               Visibility="{Binding Settings.ShowRaces, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- Bonusy pro celou hru na jednom řádku, jen když je panel s detaily schovaný. -->
                                    <TextBlock Text="{Binding Buffs}" Foreground="{DynamicResource Brush.Gold}" FontSize="9.5" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasInlineBuffs, Converter={StaticResource BoolToVisibility}}"
                                               ToolTip="Bonusy platné pro celou hru" />
                                    <Grid Margin="6,6,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="30" /><ColumnDefinition Width="26" /><ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="#" Style="{StaticResource ColumnTitleStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="HRDINA" Style="{StaticResource ColumnTitleStyle}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="2" Text="HP" Style="{StaticResource ColumnTitleStyle}" />
                                        <TextBlock Grid.Column="3" Text="ARM" Style="{StaticResource ColumnTitleStyle}" ToolTip="Armor" />
                                        <TextBlock Grid.Column="4" Text="TIER" Style="{StaticResource ColumnTitleStyle}" />
                                        <TextBlock Grid.Column="5" Text="TRIP" Style="{StaticResource ColumnTitleStyle}" ToolTip="Počet dosažených triplů" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Participants}" MinHeight="{Binding LobbyMinHeight}" Margin="0,3,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="5" Padding="6,0" Margin="{Binding RowMargin}"
                                                        Height="{Binding DataContext.LobbyRowHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        ToolTipService.InitialShowDelay="180" ToolTipService.ShowDuration="120000"
                                                        ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6">
                                                    <Border.ToolTip>
                                                        <ToolTip MaxWidth="1120">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding HeroName}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding BattleTag}" Foreground="{DynamicResource Brush.Text2}"
                                                                           FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding BoardCaption}" Foreground="{DynamicResource Brush.Accent}"
                                                                           FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Board}" Style="{StaticResource MinionCardsStyle}" Margin="0,7,0,0"
                                                                              Visibility="{Binding HasBoard, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNextOpponent}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.OpponentSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTeammate}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.TeammateSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.LocalSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="30" /><ColumnDefinition Width="26" /><ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Place}" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.Text3}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" MaxWidth="150" /><ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="☠" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Brush.Negative}" ToolTip="Hráč je vyřazený"
                                                                           Visibility="{Binding IsEliminated, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding HeroName}" FontWeight="SemiBold" FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding BattleTag}" Foreground="{DynamicResource Brush.Text3}"
                                                                           FontSize="8.5" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           Visibility="{Binding DataContext.ShowInlineBattleTag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding BattleTag}" Foreground="{DynamicResource Brush.Text3}" FontSize="8.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding DataContext.ShowBattleTagLine, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Health}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Health}" FontWeight="Bold" FontSize="10.5" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Armor}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Armor}" FontSize="10.5" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Tier}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" FontSize="10.5" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Triples}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Text2}" FontSize="10.5" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Desky: vlastní a protější. -->
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6" Grid.IsSharedSizeScope="True"
                                Visibility="{Binding Settings.ShowBoards, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ToggleButton x:Name="BoardsToggle" Style="{StaticResource SectionHeaderStyle}"
                                              IsChecked="{Binding AreBoardsCollapsed, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                              ToolTip="Skrýt nebo zobrazit desky">
                                    <TextBlock Text="{Binding PlayerBoardTitle}" Style="{StaticResource SectionTitleStyle}" />
                                </ToggleButton>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=BoardsToggle, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding PlayerBoard}" Style="{StaticResource MinionListStyle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding OpposingBoardTitle}" Style="{StaticResource SectionTitleStyle}" Margin="12,7,0,0" />
                                    <ItemsControl ItemsSource="{Binding OpposingBoard}" Style="{StaticResource MinionListStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ruka: karty a tavern kouzla, navíc k tomu, co hra sama ukazuje. -->
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6" Grid.IsSharedSizeScope="True"
                                Visibility="{Binding Settings.ShowHand, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ToggleButton x:Name="HandToggle" Style="{StaticResource SectionHeaderStyle}" IsChecked="True">
                                    <TextBlock Text="{Binding HandTitle}" Style="{StaticResource SectionTitleStyle}" />
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding Hand}" Style="{StaticResource MinionListStyle}" MinHeight="15" Margin="0,4,0,0"
                                              Visibility="{Binding IsChecked, ElementName=HandToggle, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Detaily pod hlavním sloupcem, když je tak nastavené umístění. -->
                        <ContentControl x:Name="DetailsBelowHost" ContentTemplate="{StaticResource DetailsTemplate}" Content="{Binding}"
                                        Visibility="Collapsed" Margin="0,0,0,6" />

                        <!-- Události: jediný scrollovatelný panel. -->
                        <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,6"
                                Visibility="{Binding Settings.ShowEvents, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ToggleButton x:Name="EventsToggle" Style="{StaticResource SectionHeaderStyle}" IsChecked="True">
                                    <TextBlock Text="UDÁLOSTI" Style="{StaticResource SectionTitleStyle}" />
                                </ToggleButton>
                                <ListBox ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0" Margin="0,4,0,0"
                                         MinHeight="{Binding EventsMinHeight}" MaxHeight="{Binding EventsMaxHeight}"
                                         Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Visibility="{Binding IsChecked, ElementName=EventsToggle, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,3" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text2}" FontSize="9.5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Pruhy, které se ukazují jen občas: aktualizace, načítání zápasu, hudba. -->
                        <Border Background="{DynamicResource Brush.PositiveSoft}" BorderBrush="{DynamicResource Brush.Positive}" BorderThickness="1"
                                CornerRadius="6" Padding="8,5" Margin="0,0,0,6"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UpdateStatus}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="Restartovat" Click="RestartForUpdateButton_Click" Margin="8,0,0,0" Padding="8,3" FontSize="10"
                                        Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="8,6" Margin="0,0,0,6"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding LoadStatus}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{Binding LoadProgress, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="6,5" Margin="0,0,0,6"
                                Visibility="{Binding IsMediaVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="5" Background="{DynamicResource Brush.Surface2}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,8,0"
                                        VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" Style="{StaticResource GlyphStyle}" FontSize="12" Foreground="{DynamicResource Brush.Text3}" />
                                        <Image Source="{Binding MediaArt}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MediaTitle}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MediaSubtitle}" Foreground="{DynamicResource Brush.Text2}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Button Style="{StaticResource IconButtonStyle}" Click="MediaPreviousButton_Click" IsEnabled="{Binding CanMediaPrevious}"
                                            ToolTip="Předchozí skladba" Width="24">
                                        <TextBlock Text="&#xE892;" Style="{StaticResource GlyphStyle}" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Click="MediaPlayPauseButton_Click" IsEnabled="{Binding CanMediaPlayPause}"
                                            ToolTip="{Binding MediaPlayTooltip}" Width="24">
                                        <TextBlock Text="{Binding MediaPlayGlyph}" Style="{StaticResource GlyphStyle}" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Click="MediaNextButton_Click" IsEnabled="{Binding CanMediaNext}"
                                            ToolTip="Další skladba" Width="24">
                                        <TextBlock Text="&#xE893;" Style="{StaticResource GlyphStyle}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Patička: stav vlevo, ovládání vpravo. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="9.5" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text2}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Diagnostics}">
                                <Run Text="{Binding GameStatus, Mode=OneWay}" /><Run Text=" · výsledek: " /><Run Text="{Binding Result, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button Style="{StaticResource IconButtonStyle}" Click="PatchNotesButton_Click"
                                        ToolTip="Patch notes Hearthstone ve vestavěném prohlížeči">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource GlyphStyle}" FontSize="12" />
                                </Button>
                                <Button x:Name="ActionsButton" Style="{StaticResource IconButtonStyle}" Click="ActionsButton_Click" ToolTip="Ovládání trackeru">
                                    <TextBlock Text="&#xE712;" Style="{StaticResource GlyphStyle}" FontSize="12" />
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ActionsMenu">
                                            <MenuItem Header="Vybrat log…" Tag="&#xE8E5;" Click="SelectLogButton_Click" />
                                            <MenuItem Header="Spustit demo" Tag="&#xE768;" Click="DemoButton_Click" />
                                            <MenuItem Header="{Binding PauseButtonText}" Tag="&#xE769;" IsEnabled="{Binding IsPauseEnabled}" Click="PauseButton_Click" />
                                            <Separator />
                                            <MenuItem Header="Nastavení…" Tag="&#xE713;" Click="SettingsButton_Click" />
                                            <MenuItem Header="Vrátit okno na obrazovku" Tag="&#xE923;" Click="ResetWindowButton_Click" />
                                            <MenuItem Header="Restart" Tag="&#xE72C;" Click="RestartButton_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Detaily vpravo od hlavního sloupce. -->
                    <ContentControl x:Name="DetailsRightHost" Grid.Column="1" Width="204" Margin="0,8,10,8" VerticalAlignment="Top"
                                    ContentTemplate="{StaticResource DetailsTemplate}" Content="{Binding}" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</Window>
