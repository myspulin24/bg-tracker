<Window x:Class="Tracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battlegrounds Tracker Overlay" Icon="Assets/bg-tracker.ico" Width="736" Height="1163"
        MinWidth="440" MinHeight="640" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <!-- Kartička minionu ve stylu hry. Nemá obdélníkový podklad: portrét je vystřižený do
             oválu s prstencem, pod ním je jmenná páska, rámeček s popisem efektu, páska s typem
             minionu a v dolních rozích drahokamy s útokem a životem. Protože karta nese všechno
             sama, dají se karty skládat vedle sebe. -->
        <DataTemplate x:Key="MinionCardTemplate">
            <Grid Width="148" Height="214" Margin="0,0,8,9" Background="Transparent">
                <!-- Podklad karty. Bez něj se karty v řadě slijí a není poznat, ke které kartě
                     patří který drahokam. -->
                <Border CornerRadius="9" Background="#D60A1018" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2E3D52" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                    <Setter Property="BorderBrush" Value="#7A5A1E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Rámeček popisu, na jehož spodní hranu dosedá páska s typem minionu. -->
                <Border VerticalAlignment="Top" Margin="8,113,8,0" Height="74" CornerRadius="5"
                        Background="#DE060B14" BorderBrush="#33455C" BorderThickness="1">
                    <StackPanel Margin="6,4,6,4">
                        <TextBlock Text="{Binding Keywords}" FontSize="8" FontWeight="Bold"
                                   Foreground="#E0B24A" TextWrapping="Wrap" MaxHeight="20"
                                   LineHeight="10" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                   Visibility="{Binding HasKeywords, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Card.Text}" FontSize="8.5" Foreground="#D6DEEA"
                                   TextWrapping="Wrap" LineHeight="11" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Card.HasText, Converter={StaticResource BoolToVisibility},
                                                        FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <!-- Portrét. Ovál slouží zároveň jako ořez, takže kolem kresby nezůstane pozadí. -->
                <Grid Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0">
                    <Ellipse Fill="#0C121C" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <!-- Kresba je čtvercová a po vepsání do oválu koukaly v okrajích její
                                 světlé kraje. Viewbox z ní bere jen prostředních 74 %, o kousek
                                 výš, protože postava na kartě sedí v horní polovině. -->
                            <ImageBrush ImageSource="{Binding Card.Image}" Stretch="UniformToFill"
                                        Viewbox="0.13,0.09,0.74,0.74" ViewboxUnits="RelativeToBoundingBox" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse StrokeThickness="3.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Stroke">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                            <GradientStop Color="#C9D6E6" Offset="0" />
                                            <GradientStop Color="#6C7E96" Offset="0.5" />
                                            <GradientStop Color="#39485E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                        <Setter Property="Stroke">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                                    <GradientStop Color="#FBE9A8" Offset="0" />
                                                    <GradientStop Color="#D9A63C" Offset="0.5" />
                                                    <GradientStop Color="#8A661C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <!-- Štít tavern tieru, jako ve hře vlevo nahoře přes okraj portrétu. -->
                <Border Width="27" Height="29" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0"
                        Background="#A8156A" BorderBrush="#E8C87A" BorderThickness="1.5"
                        CornerRadius="4,4,12,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tier}" FontSize="12" FontWeight="Bold" Foreground="#FFF2CE" />
                        <TextBlock Text="★" FontSize="7" Foreground="#FFF2CE" Margin="1,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="★" FontSize="15" FontWeight="Bold" Foreground="#F4D06F"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                           Visibility="{Binding IsGolden, Converter={StaticResource BoolToVisibility}}" />

                <!-- Jmenná páska přes spodek portrétu. -->
                <Border VerticalAlignment="Top" Margin="6,94,6,0" Height="23" CornerRadius="3"
                        Background="#F0231A12" BorderBrush="#7A6238" BorderThickness="1" Padding="5,0">
                    <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="Bold" Foreground="#F7EFDD"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="21" LineHeight="10"
                               LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Páska s typem minionu dosedá na spodní hranu popisu, jako ve hře. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,179,0,0"
                        Background="#F02A2114" BorderBrush="#7A6238" BorderThickness="1"
                        CornerRadius="3" Padding="7,0,7,1" MaxWidth="86"
                        Visibility="{Binding HasRace, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Race}" FontSize="8.5" Foreground="#E4D8BE"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Drahokamy s aktuálním útokem a životem. Viewbox zmenší i čtyřmístná čísla. -->
                <Grid Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,1">
                    <Ellipse Stroke="#6B4E17" StrokeThickness="1.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#F6D072" Offset="0" />
                                <GradientStop Color="#C68C22" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="6,9,6,9">
                        <TextBlock Text="{Binding Attack}" FontWeight="Bold" Foreground="#2A1B02" />
                    </Viewbox>
                </Grid>
                <Grid Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1">
                    <Ellipse Stroke="#5E1A16" StrokeThickness="1.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#F08078" Offset="0" />
                                <GradientStop Color="#A82A22" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="6,9,6,9">
                        <TextBlock Text="{Binding Health}" FontWeight="Bold" Foreground="#FFF1EE" />
                    </Viewbox>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="MinionCardsStyle" TargetType="ItemsControl">
            <Setter Property="MaxWidth" Value="1094" />
            <Setter Property="ItemTemplate" Value="{StaticResource MinionCardTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Desky se nikdy nescrollují: ItemsControl místo ListBoxu a rezervovaná výška
             na maximální možný počet minionů, aby overlay při změně počtu neposkakoval. -->
        <Style x:Key="MinionListStyle" TargetType="ItemsControl">
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Height="18" Background="Transparent"
                              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="120000"
                              ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6">
                            <!-- V okně se na kartičku místo nenajde, ale po najetí myší se ukáže
                                 zvětšená; je to tatáž šablona, jen zvětšená transformací. -->
                            <Grid.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MinionCardTemplate}">
                                            <ContentPresenter.LayoutTransform>
                                                <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryText}"
                                                   FontSize="11" MaxWidth="248" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <!-- SharedSizeGroup drží stejnou šířku napříč všemi řádky seznamu.
                                 Bez něj si každý řádek měří Auto sloupce sám a hodnoty se
                                 nezarovnají pod sebe. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13" />
                                <ColumnDefinition Width="Auto" MaxWidth="170" SharedSizeGroup="MinionName" />
                                <ColumnDefinition Width="Auto" MaxWidth="140" SharedSizeGroup="MinionKeywords" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" Foreground="#6E7E96" FontSize="9" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="★" Foreground="#F4D06F" FontSize="10" Margin="0,0,3,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsGolden, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Keywords}" Foreground="#7C8CA4" FontSize="9"
                                       Margin="6,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="⚔" Foreground="#C8B27A" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Attack}" FontSize="11" FontWeight="SemiBold" Foreground="#EBD9A6" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="♥" Foreground="#C4685F" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Health}" FontSize="11" FontWeight="SemiBold" Foreground="#FA7B72" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" />
                                <TextBlock Text="★" FontSize="9" Foreground="{StaticResource Accent}"
                                           Margin="1,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        </Style>

        <Style x:Key="ColumnTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Boční panel. Řádek je vždycky štítek vlevo a hodnota vpravo, aby se hodnoty všech
             sekcí zarovnaly na jednu linku. Neznámá i nulová hodnota zůstává tlumená a rozsvítí
             se teprve tím, že v dané hře nastala; panel tak nikdy neposkočí, jen změní barvu. -->
        <Style x:Key="PanelLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#8E9FB8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PanelValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5C6C83" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- Hodnota, která má smysl vždycky, tedy zlato a ceny. Bonusy a trinkety proti tomu
             začínají tlumené a rozsvítí se, až v dané hře nastanou. -->
        <Style x:Key="PanelStrongValueStyle" TargetType="TextBlock" BasedOn="{StaticResource PanelValueStyle}">
            <Setter Property="Foreground" Value="#D8E2EF" />
        </Style>

        <Style x:Key="PanelSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>

        <Style x:Key="PanelDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#22304A" />
            <Setter Property="Margin" Value="0,6,0,8" />
        </Style>

        <Style x:Key="PanelRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Border x:Name="RootCard" Width="736" Height="1163"
                Background="#F20B1019" BorderBrush="#536987" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hlavička. Ve sbaleném overlayi zůstane jako jediná vidět, a proto se jí
                     v kódu dorovnává zakulacení: sbalená je celá karta, ne jen její horní okraj. -->
                <Border x:Name="HeaderCard" Grid.Row="0" Background="#FA101825" CornerRadius="11,11,0,0"
                        BorderBrush="#26344A" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                            <Border Width="30" Height="30" CornerRadius="7" Background="#111A28" BorderBrush="#536987"
                                    BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="BG" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold"
                                           ToolTip="{Binding Diagnostics}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TitleText" Text="BATTLEGROUNDS TRACKER" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <!-- Verze hned za názvem. Výška odznáčku je svázaná s výškou titulku,
                                         aby s ním dosedl na stejnou linku. Ladicí build se odliší okrovou
                                         barvou a rámečkem, aby se nedal splést s vydanou verzí. -->
                                    <Border Margin="8,0,0,0" Padding="5,0" CornerRadius="3" VerticalAlignment="Center"
                                            Height="{Binding ActualHeight, ElementName=TitleText}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#16202E" />
                                                <Setter Property="BorderBrush" Value="#2C3B52" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDevelopmentBuild}" Value="True">
                                                        <Setter Property="Background" Value="#3A2C10" />
                                                        <Setter Property="BorderBrush" Value="#8A6A22" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Version, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDevelopmentBuild}" Value="True">
                                                            <Setter Property="Foreground" Value="#F4D06F" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Positive}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Foreground="{StaticResource SecondaryText}" FontSize="10" MaxWidth="330"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceTooltip}">
                                        <Run Text="{Binding ModeLabel, Mode=OneWay}" FontWeight="Bold" /><Run Text=" • " /><Run Text="{Binding GameMode, Mode=OneWay}" FontWeight="Bold" Foreground="#E6A23C" /><Run Text=" • " /><Run Text="{Binding SourceDescription, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SidePanelButton" Content="◧" ToolTip="Skrýt boční panel"
                                    Click="SidePanelButton_Click"
                                    Width="34" Height="32" Padding="0" FontSize="15" Margin="0,0,7,0" />
                            <Button x:Name="CollapseButton" Content="−" ToolTip="Sbalit overlay" Click="CollapseButton_Click"
                                    Width="34" Height="32" Padding="0" FontSize="18" />
                            <Button Content="×" ToolTip="Ukončit tracker" Click="CloseButton_Click"
                                    Width="34" Height="32" Padding="0" FontSize="19" Margin="7,0,0,0"
                                    Background="#47242A" BorderBrush="#75404A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ContentPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500" />
                        <!-- Boční panel. Šířka je v návrhových jednotkách, takže ho Viewbox
                             škáluje stejně jako zbytek karty. Sloupec zmizí s panelem, aby
                             se okno zúžilo zpátky na původních 500. -->
                        <ColumnDefinition x:Name="SideColumn" Width="236" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="16,14,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <!-- Události berou všechno, co zbyde, a mají vlastní scrollbar. MinHeight
                                 musí zůstat malá: karta má pevnou výšku, takže při zobrazení pruhu
                                 s načítáním nebo aktualizací se přebytek nemá kam vejít a odřízl by
                                 spodní lištu s tlačítky. -->
                            <RowDefinition Height="*" MinHeight="60" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="9,6">
                                <StackPanel>
                                    <TextBlock Text="KOLO" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding Turn}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="9,6">
                                <StackPanel>
                                    <TextBlock Text="MÍSTO" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding Place}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Positive}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="9,6">
                                <StackPanel>
                                    <TextBlock Text="ZLATO" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding Gold}" FontSize="19" FontWeight="Bold" Foreground="#F4D06F" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="9,6">
                                <StackPanel>
                                    <TextBlock Text="FÁZE" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding Phase}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NextOpponent}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TavernUpgrade}" Foreground="{StaticResource SecondaryText}"
                                               FontSize="10" Margin="8,1,0,0" />
                                </Grid>
                                <TextBlock Text="{Binding AvailableRaces}" Foreground="{StaticResource SecondaryText}" FontSize="10"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="Typy minionů, které se v této lobby objevily v nabídce Boba" />
                                <!-- Bonusy pro celou hru na jednom řádku. Ukazuje se jen tehdy, když je
                                     boční panel schovaný; jinak by tatáž informace stála na dvou místech. -->
                                <TextBlock Text="{Binding Buffs}" Foreground="#F4D06F" FontSize="10"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasInlineBuffs, Converter={StaticResource BoolToVisibility}}"
                                           ToolTip="Bonusy platné pro celou hru: o kolik víc dávají tavern kouzla a blood gemy a jaký plošný buff mají elementálové a piráti" />
                                <Grid Margin="9,8,9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="40" /><ColumnDefinition Width="30" /><ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" Style="{StaticResource ColumnTitleStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="HRDINA / BATTLETAG" Style="{StaticResource ColumnTitleStyle}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="2" Text="HP" Style="{StaticResource ColumnTitleStyle}" />
                                    <TextBlock Grid.Column="3" Text="ARMOR" Style="{StaticResource ColumnTitleStyle}" />
                                    <TextBlock Grid.Column="4" Text="TIER" Style="{StaticResource ColumnTitleStyle}" />
                                    <TextBlock Grid.Column="5" Text="TRIPLE" Style="{StaticResource ColumnTitleStyle}" ToolTip="Počet dosažených triplů" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Participants}" MinHeight="328" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="5" Padding="9,4" Margin="{Binding RowMargin}" Height="38"
                                                    ToolTipService.InitialShowDelay="180" ToolTipService.ShowDuration="120000"
                                                    ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6">
                                                <Border.ToolTip>
                                                    <ToolTip MaxWidth="1120">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding HeroName}" FontWeight="Bold" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding BattleTag}" Foreground="{StaticResource SecondaryText}"
                                                                       FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding BoardCaption}" Foreground="{StaticResource Accent}"
                                                                       FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                            <ItemsControl ItemsSource="{Binding Board}" Style="{StaticResource MinionCardsStyle}"
                                                                          Margin="0,7,0,0"
                                                                          Visibility="{Binding HasBoard, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#192433" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNextOpponent}" Value="True">
                                                                <Setter Property="Background" Value="#33281A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTeammate}" Value="True">
                                                                <Setter Property="Background" Value="#1A3A34" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                                <Setter Property="Background" Value="#1B3048" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                                                                <Setter Property="Opacity" Value="0.45" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="40" /><ColumnDefinition Width="30" /><ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Place}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="☠" FontSize="12" Margin="0,0,5,0" Foreground="#E0736E"
                                                                       ToolTip="Hráč je vyřazený"
                                                                       Visibility="{Binding IsEliminated, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding HeroName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding BattleTag}" Foreground="{StaticResource SecondaryText}" FontSize="9" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Health}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FA7B72" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Armor}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A9C8EA" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Tier}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Triples}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Na nižším monitoru je tahle sekce první na sbalení; ušetří skoro 300 px. -->
                        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12,10">
                            <StackPanel>
                                <Button x:Name="ToggleBoardsButton" Click="ToggleBoardsButton_Click" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        ToolTip="Skrýt nebo zobrazit desky">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BoardsChevron" Text="▾" Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,6,0" />
                                        <TextBlock x:Name="BoardsHeader" Grid.Column="1" Text="MOJE DESKA"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="BoardsContent" Grid.IsSharedSizeScope="True">
                                    <ItemsControl ItemsSource="{Binding PlayerBoard}" Style="{StaticResource MinionListStyle}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding OpposingBoardTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,9,0,0" />
                                    <ItemsControl ItemsSource="{Binding OpposingBoard}" Style="{StaticResource MinionListStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Jediný scrollovatelný panel. Drží posledních osm událostí, a proto musí zůstat
                             interaktivní, jinak by kolečko ani scrollbar nefungovaly. -->
                        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="POSLEDNÍ UDÁLOSTI" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0"
                                         Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,5" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Border Background="#1E2E1F" BorderBrush="#3C6B40" BorderThickness="1" CornerRadius="6"
                                        Padding="10,6" Margin="0,0,0,7"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UpdateStatus}" FontSize="11" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Restartovat" Click="RestartForUpdateButton_Click"
                                                Margin="8,0,0,0" Padding="9,4" FontSize="11"
                                                Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Border>
                                <Border Background="#1B2838" BorderBrush="#3A5878" BorderThickness="1" CornerRadius="6"
                                        Padding="10,7" Margin="0,0,0,7"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LoadStatus}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding LoadProgress, Mode=OneWay}" Minimum="0" Maximum="100"
                                                     Height="6" Margin="0,6,0,0" Background="#11202F" BorderThickness="0"
                                                     Foreground="{StaticResource Accent}" />
                                    </StackPanel>
                                </Border>
                                <!-- Co právě hraje. Čte se ze systémového rozhraní pro média, takže je
                                     tu Spotify, YouTube v prohlížeči i YouTube Music bez přihlašování.
                                     Proužek je ve stejném stohu jako pruhy s aktualizací a načítáním,
                                     protože ty se taky ukazují jen občas a skryté nezaberou místo.
                                     Ukazatel postupu tu schválně není: přehrávače pozici ve skladbě do
                                     systému průběžně neposílají, takže by stál na místě. -->
                                <Border Background="#141E2C" BorderBrush="#2C3B52" BorderThickness="1" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,0,7"
                                        Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="5" Background="#0C1521"
                                                BorderBrush="#2C3B52" BorderThickness="1" Margin="0,0,9,0"
                                                VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource GlyphStyle}" FontSize="14"
                                                           Foreground="{StaticResource SecondaryText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding MediaArt}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MediaTitle}" FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MediaSubtitle}" Foreground="{StaticResource SecondaryText}"
                                                       FontSize="9.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="8,0,0,0">
                                            <Button x:Name="MediaPreviousButton" Style="{StaticResource IconButtonStyle}" Margin="0,0,5,0"
                                                    Click="MediaPreviousButton_Click" IsEnabled="{Binding CanMediaPrevious}"
                                                    ToolTip="Předchozí skladba">
                                                <TextBlock Text="&#xE892;" Style="{StaticResource GlyphStyle}" FontSize="12" />
                                            </Button>
                                            <Button x:Name="MediaPlayPauseButton" Style="{StaticResource IconButtonStyle}" Margin="0,0,5,0"
                                                    Click="MediaPlayPauseButton_Click" IsEnabled="{Binding CanMediaPlayPause}"
                                                    ToolTip="{Binding MediaPlayTooltip}">
                                                <TextBlock Text="{Binding MediaPlayGlyph}" Style="{StaticResource GlyphStyle}"
                                                           FontSize="12" />
                                            </Button>
                                            <Button x:Name="MediaNextButton" Style="{StaticResource IconButtonStyle}"
                                                    Click="MediaNextButton_Click" IsEnabled="{Binding CanMediaNext}"
                                                    ToolTip="Další skladba">
                                                <TextBlock Text="&#xE893;" Style="{StaticResource GlyphStyle}" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- Stav a diagnostika vlevo, ovládání vpravo jako dvě ikony. Samostatný
                                 řádek s tlačítky zabíral v pevné výšce karty skoro 40 px. -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding GameStatus, Mode=OneWay}" /><Run Text=" • výsledek: " /><Run Text="{Binding Result, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Diagnostics}" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Click="PatchNotesButton_Click" Margin="0,0,7,0"
                                            ToolTip="Patch notes Hearthstone ve vestavěném prohlížeči">
                                        <TextBlock Text="&#xE8A5;" Style="{StaticResource GlyphStyle}" FontSize="14" />
                                    </Button>
                                    <Button x:Name="ActionsButton" Style="{StaticResource IconButtonStyle}"
                                            Click="ActionsButton_Click"
                                            ToolTip="Ovládání trackeru">
                                        <TextBlock Text="&#xE712;" Style="{StaticResource GlyphStyle}" FontSize="14" />
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="ActionsMenu">
                                                <MenuItem Header="Vybrat log…" Tag="&#xE8E5;" Click="SelectLogButton_Click" />
                                                <MenuItem Header="Spustit demo" Tag="&#xE768;" Click="DemoButton_Click" />
                                                <MenuItem Header="{Binding PauseButtonText}" Tag="&#xE769;"
                                                          IsEnabled="{Binding IsPauseEnabled}" Click="PauseButton_Click" />
                                                <Separator />
                                                <MenuItem Header="Vrátit okno na obrazovku" Tag="&#xE923;"
                                                          Click="ResetWindowButton_Click" />
                                                <MenuItem Header="Restart" Tag="&#xE72C;" Click="RestartButton_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Boční panel. Všechny tři sekce čtou hodnoty, které hra drží na entitě
                         hráče, na entitách slotů na trinkety a na tlačítkách krčmy, takže jsou
                         přesné a nic se nedopočítává. -->
                    <StackPanel x:Name="SidePanel" Grid.Column="1" Margin="0,14,16,14">
                        <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="BONUSY PRO CELOU HRU" Style="{StaticResource PanelSectionStyle}" />
                                <Border Style="{StaticResource PanelDividerStyle}" />

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#7EA8E0" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Tavern kouzla" Style="{StaticResource PanelLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SpellBuff}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSpellBuff}" Value="True">
                                                        <Setter Property="Foreground" Value="#F4D06F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#D06B6B" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Blood gemy" Style="{StaticResource PanelLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding BloodGemBuff}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBloodGemBuff}" Value="True">
                                                        <Setter Property="Foreground" Value="#F4D06F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#E09A4A" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Elementálové" Style="{StaticResource PanelLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementalBuff}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasElementalBuff}" Value="True">
                                                        <Setter Property="Foreground" Value="#F4D06F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#6FBFA0" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Piráti" Style="{StaticResource PanelLabelStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PirateBuff}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPirateBuff}" Value="True">
                                                        <Setter Property="Foreground" Value="#F4D06F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Undeadi mají jen útok: život se jim takhle nebuffuje. Hodnotu
                                     nese enchantment hráče, ne tag, viz 8.6b. -->
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#A98FD3" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Undead (útok)" Style="{StaticResource PanelLabelStyle}"
                                                   ToolTip="Nasčítaný útok, který mají undeadi navíc po celou hru" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UndeadBuff}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUndeadBuff}" Value="True">
                                                        <Setter Property="Foreground" Value="#F4D06F" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Karty, které si samy zvyšují hodnotu. Nejsou to bonusy pro celou hru:
                             hra je drží na kartě, ne na entitě hráče, a text karty přitom pořád
                             ukazuje výchozí čísla. Sekce se ukazuje jen tehdy, když taková karta
                             na desce je. -->
                        <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,9"
                                Visibility="{Binding HasCardCounters, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="BONUSY NA KARTÁCH" Style="{StaticResource PanelSectionStyle}" />
                                <Border Style="{StaticResource PanelDividerStyle}" />
                                <ItemsControl ItemsSource="{Binding CardCounters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5" Background="Transparent"
                                                  ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                                                  ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6"
                                                  ToolTipService.IsEnabled="{Binding Card.HasText,
                                                                                     FallbackValue=False, TargetNullValue=False}">
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="260">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Card.Text}" FontSize="11"
                                                                       Foreground="{StaticResource SecondaryText}"
                                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource PanelLabelStyle}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           Style="{StaticResource PanelValueStyle}" Foreground="#F4D06F" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Trinkety. Dokud slot není obsazený, je v něm odpočet kol; po výběru
                             se v téže entitě objeví jméno trinketu. Po najetí myší se ukáže popis
                             efektu z databáze karet. -->
                        <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="TRINKETY" Style="{StaticResource PanelSectionStyle}" />
                                <Border Style="{StaticResource PanelDividerStyle}" />

                                <Grid Margin="0,0,0,8" Background="Transparent"
                                      ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                                      ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6"
                                      ToolTipService.IsEnabled="{Binding LesserTrinketCard.HasText,
                                                                         FallbackValue=False, TargetNullValue=False}">
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="260">
                                                <TextBlock Text="{Binding LesserTrinket}" FontWeight="Bold" FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LesserTrinketCard.Text}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#0F1926"
                                            BorderBrush="#2C3B52" BorderThickness="1" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="◆" FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4E5D73" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLesserTrinket}" Value="True">
                                                            <Setter Property="Foreground" Value="#C9A44C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MALÝ" FontSize="8" FontWeight="Bold" Foreground="#6E7E96" />
                                        <TextBlock Text="{Binding LesserTrinket}" FontSize="10.5" Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7E8EA6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLesserTrinket}" Value="True">
                                                            <Setter Property="Foreground" Value="#E8DFC8" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Grid Background="Transparent"
                                      ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="60000"
                                      ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6"
                                      ToolTipService.IsEnabled="{Binding GreaterTrinketCard.HasText,
                                                                         FallbackValue=False, TargetNullValue=False}">
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="260">
                                                <TextBlock Text="{Binding GreaterTrinket}" FontWeight="Bold" FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding GreaterTrinketCard.Text}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#0F1926"
                                            BorderBrush="#2C3B52" BorderThickness="1" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="◆" FontSize="13" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4E5D73" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasGreaterTrinket}" Value="True">
                                                            <Setter Property="Foreground" Value="#E8C87A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VELKÝ" FontSize="8" FontWeight="Bold" Foreground="#6E7E96" />
                                        <TextBlock Text="{Binding GreaterTrinket}" FontSize="10.5" Margin="0,1,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7E8EA6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasGreaterTrinket}" Value="True">
                                                            <Setter Property="Foreground" Value="#E8DFC8" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Ekonomika krčmy. Cena rerollu i upgradu se bere z tlačítek, takže
                             sedí i po zlevnění efektem; volné rerolly a zlato navíc se ukazují
                             jen tehdy, když je hráč skutečně má. -->
                        <Border Style="{StaticResource CardStyle}" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="EKONOMIKA KRČMY" Style="{StaticResource PanelSectionStyle}" />
                                <Border Style="{StaticResource PanelDividerStyle}" />

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Zlato" Style="{StaticResource PanelLabelStyle}"
                                               ToolTip="Kolik zlata je k utracení a jaký je strop tohohle kola" />
                                    <TextBlock Grid.Column="1" Text="{Binding GoldDetail}"
                                               Style="{StaticResource PanelStrongValueStyle}" Foreground="#F4D06F" />
                                </Grid>

                                <!-- Bonus tohohle kola je zlato nad strop, které přišlo z karet
                                     zahraných minule. Bez tohohle řádku není poznat, proč je
                                     k utracení víc, než kolik kolo dává. Ukazuje se i v nule,
                                     aby bylo vidět, že žádný bonus není. -->
                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bonus toto kolo">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelLabelStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTempGold}" Value="True">
                                                        <Setter Property="Foreground" Value="#8FD3B0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#141E2C" />
                                                <Setter Property="BorderBrush" Value="#2C3B52" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTempGold}" Value="True">
                                                        <Setter Property="Background" Value="#16301F" />
                                                        <Setter Property="BorderBrush" Value="#3C6B40" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TempGold}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5C6C83" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTempGold}" Value="True">
                                                            <Setter Property="Foreground" Value="#8FD3B0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Utraceno v kole" Style="{StaticResource PanelLabelStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding GoldSpent}"
                                               Style="{StaticResource PanelStrongValueStyle}" />
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cena rerollu" Style="{StaticResource PanelLabelStyle}"
                                               ToolTip="Kolik zlata stojí obnovení nabídky Boba. Při volném rerollu je nula." />
                                    <TextBlock Grid.Column="1" Text="{Binding RefreshCost}"
                                               Style="{StaticResource PanelStrongValueStyle}" />
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}"
                                      Visibility="{Binding HasFreeRefreshes, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rerolly zdarma" Style="{StaticResource PanelLabelStyle}"
                                               Foreground="#E8C87A"
                                               ToolTip="Kolik rerollů zbývá zdarma" />
                                    <Border Grid.Column="1" Background="#3A2E12" BorderBrush="#8A6A22" BorderThickness="1"
                                            CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding FreeRefreshes}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#F4D06F" />
                                    </Border>
                                </Grid>

                                <Grid Style="{StaticResource PanelRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cena upgradu" Style="{StaticResource PanelLabelStyle}"
                                               ToolTip="Kolik zlata stojí posun na další tavern tier. Na posledním tieru je místo ceny „max“." />
                                    <TextBlock Grid.Column="1" Text="{Binding UpgradeCost}"
                                               Style="{StaticResource PanelStrongValueStyle}" />
                                </Grid>

                                <!-- Bonus na příští kolo přibývá z karet zahraných teď. Hra ho
                                     drží na entitě hráče jako součet, takže sem spadne i mech,
                                     který zlato generuje sám. Podmíněné „když vyhraju“ tu není:
                                     to hra do součtu přidá teprve po vyhraném souboji. -->
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bonus příští kolo">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelLabelStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExtraGold}" Value="True">
                                                        <Setter Property="Foreground" Value="#8FD3B0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#141E2C" />
                                                <Setter Property="BorderBrush" Value="#2C3B52" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExtraGold}" Value="True">
                                                        <Setter Property="Background" Value="#16301F" />
                                                        <Setter Property="BorderBrush" Value="#3C6B40" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ExtraGold}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5C6C83" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasExtraGold}" Value="True">
                                                            <Setter Property="Foreground" Value="#8FD3B0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Viewbox>
</Window>
