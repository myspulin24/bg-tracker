<Window x:Class="Tracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battlegrounds Tracker Overlay" Icon="Assets/bg-tracker.ico" Width="500" Height="1163"
        MinWidth="440" MinHeight="640" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True">
    <Window.Resources>
        <!-- Kartička minionu ve stylu hry. Nemá obdélníkový podklad: portrét je vystřižený do
             oválu s prstencem, pod ním je jmenná páska, rámeček s popisem efektu, páska s typem
             minionu a v dolních rozích drahokamy s útokem a životem. Protože karta nese všechno
             sama, dají se karty skládat vedle sebe. -->
        <DataTemplate x:Key="MinionCardTemplate">
            <Grid Width="148" Height="214" Margin="0,0,8,9" Background="Transparent">
                <!-- Podklad karty. Bez něj se karty v řadě slijí a není poznat, ke které kartě
                     patří který drahokam. -->
                <Border CornerRadius="9" Background="#D60A1018" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2E3D52" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                    <Setter Property="BorderBrush" Value="#7A5A1E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Rámeček popisu, na jehož spodní hranu dosedá páska s typem minionu. -->
                <Border VerticalAlignment="Top" Margin="8,113,8,0" Height="74" CornerRadius="5"
                        Background="#DE060B14" BorderBrush="#33455C" BorderThickness="1">
                    <StackPanel Margin="6,4,6,4">
                        <TextBlock Text="{Binding Keywords}" FontSize="8" FontWeight="Bold"
                                   Foreground="#E0B24A" TextWrapping="Wrap" MaxHeight="20"
                                   LineHeight="10" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,2"
                                   Visibility="{Binding HasKeywords, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Card.Text}" FontSize="8.5" Foreground="#D6DEEA"
                                   TextWrapping="Wrap" LineHeight="11" LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Card.HasText, Converter={StaticResource BoolToVisibility},
                                                        FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
                    </StackPanel>
                </Border>

                <!-- Portrét. Ovál slouží zároveň jako ořez, takže kolem kresby nezůstane pozadí. -->
                <Grid Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0">
                    <Ellipse Fill="#0C121C" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Card.Image}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse StrokeThickness="3.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Stroke">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                            <GradientStop Color="#C9D6E6" Offset="0" />
                                            <GradientStop Color="#6C7E96" Offset="0.5" />
                                            <GradientStop Color="#39485E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                        <Setter Property="Stroke">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                                    <GradientStop Color="#FBE9A8" Offset="0" />
                                                    <GradientStop Color="#D9A63C" Offset="0.5" />
                                                    <GradientStop Color="#8A661C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <!-- Štít tavern tieru, jako ve hře vlevo nahoře přes okraj portrétu. -->
                <Border Width="27" Height="29" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0"
                        Background="#A8156A" BorderBrush="#E8C87A" BorderThickness="1.5"
                        CornerRadius="4,4,12,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tier}" FontSize="12" FontWeight="Bold" Foreground="#FFF2CE" />
                        <TextBlock Text="★" FontSize="7" Foreground="#FFF2CE" Margin="1,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="★" FontSize="15" FontWeight="Bold" Foreground="#F4D06F"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                           Visibility="{Binding IsGolden, Converter={StaticResource BoolToVisibility}}" />

                <!-- Jmenná páska přes spodek portrétu. -->
                <Border VerticalAlignment="Top" Margin="6,94,6,0" Height="23" CornerRadius="3"
                        Background="#F0231A12" BorderBrush="#7A6238" BorderThickness="1" Padding="5,0">
                    <TextBlock Text="{Binding Name}" FontSize="9.5" FontWeight="Bold" Foreground="#F7EFDD"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="21" LineHeight="10"
                               LineStackingStrategy="BlockLineHeight" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Páska s typem minionu dosedá na spodní hranu popisu, jako ve hře. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,179,0,0"
                        Background="#F02A2114" BorderBrush="#7A6238" BorderThickness="1"
                        CornerRadius="3" Padding="7,0,7,1" MaxWidth="86"
                        Visibility="{Binding HasRace, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Race}" FontSize="8.5" Foreground="#E4D8BE"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- Drahokamy s aktuálním útokem a životem. Viewbox zmenší i čtyřmístná čísla. -->
                <Grid Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,1">
                    <Ellipse Stroke="#6B4E17" StrokeThickness="1.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#F6D072" Offset="0" />
                                <GradientStop Color="#C68C22" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="6,9,6,9">
                        <TextBlock Text="{Binding Attack}" FontWeight="Bold" Foreground="#2A1B02" />
                    </Viewbox>
                </Grid>
                <Grid Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1">
                    <Ellipse Stroke="#5E1A16" StrokeThickness="1.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3">
                                <GradientStop Color="#F08078" Offset="0" />
                                <GradientStop Color="#A82A22" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Viewbox Margin="6,9,6,9">
                        <TextBlock Text="{Binding Health}" FontWeight="Bold" Foreground="#FFF1EE" />
                    </Viewbox>
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="MinionCardsStyle" TargetType="ItemsControl">
            <Setter Property="MaxWidth" Value="1094" />
            <Setter Property="ItemTemplate" Value="{StaticResource MinionCardTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Desky se nikdy nescrollují: ItemsControl místo ListBoxu a rezervovaná výška
             na maximální možný počet minionů, aby overlay při změně počtu neposkakoval. -->
        <Style x:Key="MinionListStyle" TargetType="ItemsControl">
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Height="18" Background="Transparent"
                              ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="120000"
                              ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6">
                            <!-- V okně se na kartičku místo nenajde, ale po najetí myší se ukáže
                                 zvětšená; je to tatáž šablona, jen zvětšená transformací. -->
                            <Grid.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MinionCardTemplate}">
                                            <ContentPresenter.LayoutTransform>
                                                <ScaleTransform ScaleX="1.7" ScaleY="1.7" />
                                            </ContentPresenter.LayoutTransform>
                                        </ContentPresenter>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryText}"
                                                   FontSize="11" MaxWidth="248" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Grid.ToolTip>
                            <!-- SharedSizeGroup drží stejnou šířku napříč všemi řádky seznamu.
                                 Bez něj si každý řádek měří Auto sloupce sám a hodnoty se
                                 nezarovnají pod sebe. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13" />
                                <ColumnDefinition Width="Auto" MaxWidth="170" SharedSizeGroup="MinionName" />
                                <ColumnDefinition Width="Auto" MaxWidth="140" SharedSizeGroup="MinionKeywords" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Position}" Foreground="#6E7E96" FontSize="9" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="★" Foreground="#F4D06F" FontSize="10" Margin="0,0,3,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsGolden, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Keywords}" Foreground="#7C8CA4" FontSize="9"
                                       Margin="6,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="⚔" Foreground="#C8B27A" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Attack}" FontSize="11" FontWeight="SemiBold" Foreground="#EBD9A6" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="♥" Foreground="#C4685F" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Health}" FontSize="11" FontWeight="SemiBold" Foreground="#FA7B72" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" />
                                <TextBlock Text="★" FontSize="9" Foreground="{StaticResource Accent}"
                                           Margin="1,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        </Style>

        <Style x:Key="ColumnTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="#F20B1019" BorderBrush="#536987" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FA101825" CornerRadius="11,11,0,0" BorderBrush="#26344A" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                        <Border Width="30" Height="30" CornerRadius="7" Background="#111A28" BorderBrush="#536987"
                                BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="BG" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold"
                                       ToolTip="{Binding Diagnostics}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="BATTLEGROUNDS TRACKER" FontSize="14" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Positive}" Margin="0,0,6,0" />
                                <TextBlock Foreground="{StaticResource SecondaryText}" FontSize="10">
                                    <Run Text="{Binding ModeLabel, Mode=OneWay}" FontWeight="Bold" /><Run Text=" • " /><Run Text="{Binding GameMode, Mode=OneWay}" FontWeight="Bold" Foreground="#E6A23C" /><Run Text=" • " /><Run Text="{Binding SourceDescription, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CollapseButton" Content="−" ToolTip="Sbalit overlay" Click="CollapseButton_Click"
                                Width="34" Height="32" Padding="0" FontSize="18" />
                        <Button Content="×" ToolTip="Ukončit tracker" Click="CloseButton_Click"
                                Width="34" Height="32" Padding="0" FontSize="19" Margin="7,0,0,0"
                                Background="#47242A" BorderBrush="#75404A" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentPanel" Grid.Row="1" Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="9" />
                    <!-- Rezervuje šest řádků událostí; víc místa dostane, když okno zvětšíte. -->
                    <RowDefinition Height="*" MinHeight="159" />
                    <RowDefinition Height="9" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="9,6">
                        <StackPanel>
                            <TextBlock Text="KOLO" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Turn}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="9,6">
                        <StackPanel>
                            <TextBlock Text="MÍSTO" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Place}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Positive}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="9,6">
                        <StackPanel>
                            <TextBlock Text="ZLATO" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Gold}" FontSize="19" FontWeight="Bold" Foreground="#F4D06F" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="9,6">
                        <StackPanel>
                            <TextBlock Text="FÁZE" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding Phase}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding NextOpponent}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TavernUpgrade}" Foreground="{StaticResource SecondaryText}"
                                       FontSize="10" Margin="8,1,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding AvailableRaces}" Foreground="{StaticResource SecondaryText}" FontSize="10"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="Typy minionů, které se v této lobby objevily v nabídce Boba" />
                        <Grid Margin="9,8,9,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" />
                                <ColumnDefinition Width="40" /><ColumnDefinition Width="30" /><ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource ColumnTitleStyle}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="HRDINA / BATTLETAG" Style="{StaticResource ColumnTitleStyle}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="HP" Style="{StaticResource ColumnTitleStyle}" />
                            <TextBlock Grid.Column="3" Text="ARMOR" Style="{StaticResource ColumnTitleStyle}" />
                            <TextBlock Grid.Column="4" Text="TIER" Style="{StaticResource ColumnTitleStyle}" />
                            <TextBlock Grid.Column="5" Text="TRIPLE" Style="{StaticResource ColumnTitleStyle}" ToolTip="Počet dosažených triplů" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Participants}" MinHeight="328" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="9,4" Margin="{Binding RowMargin}" Height="38"
                                            ToolTipService.InitialShowDelay="180" ToolTipService.ShowDuration="120000"
                                            ToolTipService.Placement="Left" ToolTipService.HorizontalOffset="-6">
                                        <Border.ToolTip>
                                            <ToolTip MaxWidth="1120">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HeroName}" FontWeight="Bold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BattleTag}" Foreground="{StaticResource SecondaryText}"
                                                               FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding BoardCaption}" Foreground="{StaticResource Accent}"
                                                               FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding Board}" Style="{StaticResource MinionCardsStyle}"
                                                                  Margin="0,7,0,0"
                                                                  Visibility="{Binding HasBoard, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#192433" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNextOpponent}" Value="True">
                                                        <Setter Property="Background" Value="#33281A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTeammate}" Value="True">
                                                        <Setter Property="Background" Value="#1A3A34" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                        <Setter Property="Background" Value="#1B3048" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="40" /><ColumnDefinition Width="30" /><ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Place}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="☠" FontSize="12" Margin="0,0,5,0" Foreground="#E0736E"
                                                               ToolTip="Hráč je vyřazený"
                                                               Visibility="{Binding IsEliminated, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding HeroName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock Text="{Binding BattleTag}" Foreground="{StaticResource SecondaryText}" FontSize="9" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Health}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FA7B72" FontWeight="Bold" />
                                            <TextBlock Grid.Column="3" Text="{Binding Armor}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A9C8EA" />
                                            <TextBlock Grid.Column="4" Text="{Binding Tier}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                                            <TextBlock Grid.Column="5" Text="{Binding Triples}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Na nižším monitoru je tahle sekce první na sbalení; ušetří skoro 300 px. -->
                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12,10">
                    <StackPanel>
                        <Button Click="ToggleBoardsButton_Click" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                ToolTip="Skrýt nebo zobrazit desky">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BoardsChevron" Text="▾" Style="{StaticResource SectionTitleStyle}"
                                           Margin="0,0,6,0" />
                                <TextBlock x:Name="BoardsHeader" Grid.Column="1" Text="MOJE DESKA"
                                           Style="{StaticResource SectionTitleStyle}" />
                            </Grid>
                        </Button>
                        <StackPanel x:Name="BoardsContent" Grid.IsSharedSizeScope="True">
                            <ItemsControl ItemsSource="{Binding PlayerBoard}" Style="{StaticResource MinionListStyle}" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding OpposingBoardTitle}" Style="{StaticResource SectionTitleStyle}" Margin="0,9,0,0" />
                            <ItemsControl ItemsSource="{Binding OpposingBoard}" Style="{StaticResource MinionListStyle}" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Jediný scrollovatelný panel. Drží posledních osm událostí, a proto musí zůstat
                     interaktivní, jinak by kolečko ani scrollbar nefungovaly. -->
                <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="POSLEDNÍ UDÁLOSTI" Style="{StaticResource SectionTitleStyle}" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0"
                                 Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,5" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="11" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="7" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1E2E1F" BorderBrush="#3C6B40" BorderThickness="1" CornerRadius="6"
                            Padding="10,6" Margin="0,0,0,7"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Restartovat" Click="RestartForUpdateButton_Click"
                                    Margin="8,0,0,0" Padding="9,4" FontSize="11"
                                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock FontSize="11">
                            <Run Text="{Binding GameStatus, Mode=OneWay}" /><Run Text=" • výsledek: " /><Run Text="{Binding Result, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Diagnostics}" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Vybrat log" Click="SelectLogButton_Click" Margin="0,0,7,0" Padding="10,6" FontSize="11" />
                        <Button Content="Spustit demo" Click="DemoButton_Click" Margin="0,0,7,0" Padding="10,6" FontSize="11" />
                        <Button Content="{Binding PauseButtonText}" IsEnabled="{Binding IsPauseEnabled}" Click="PauseButton_Click" MinWidth="84" Padding="10,6" FontSize="11" />
                        <Button Content="Restart" Click="RestartButton_Click" Margin="7,0,0,0" Padding="10,6" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
