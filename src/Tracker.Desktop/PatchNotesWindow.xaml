<Window x:Class="Tracker.Desktop.PatchNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Patch notes" Icon="Assets/bg-tracker.ico"
        Width="980" Height="820" MinWidth="420" MinHeight="320"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0B1019" Topmost="True" ShowInTaskbar="True">
    <!-- Vlastní chrome ve stylu overlaye, ale s nativním chováním okna: WindowChrome dá
         změnu velikosti ze všech stran, přichytávání k okrajům i tažení za titulní lištu.
         Původní WindowStyle="None" s AllowsTransparency nechal jen úchop v pravém dolním
         rohu a tažením se okno nezvětšilo vůbec. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="#0B1019" BorderBrush="#536987" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FA101825"
                    BorderBrush="#26344A" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE8A5;" Style="{StaticResource GlyphStyle}" FontSize="15"
                               Foreground="{StaticResource Accent}" Margin="0,0,9,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="PATCH NOTES" FontSize="12" FontWeight="Bold" />
                        <TextBlock x:Name="AddressText" Foreground="{StaticResource SecondaryText}" FontSize="10"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Click="BackButton_Click"
                                ToolTip="Zpět" Margin="0,0,6,0">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource GlyphStyle}" FontSize="13" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Click="ReloadButton_Click"
                                ToolTip="Načíst znovu" Margin="0,0,6,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphStyle}" FontSize="13" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Click="OpenInBrowserButton_Click"
                                ToolTip="Otevřít v systémovém prohlížeči" Margin="0,0,14,0">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource GlyphStyle}" FontSize="13" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="32" Height="28" Padding="0" FontSize="17"
                                Click="MinimizeButton_Click" ToolTip="Minimalizovat" Content="−" />
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Width="32" Height="28" Padding="0" Margin="6,0,0,0"
                                Click="MaximizeButton_Click" ToolTip="Maximalizovat">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource GlyphStyle}" FontSize="11" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="×" Width="32" Height="28" Padding="0" FontSize="18" Margin="6,0,0,0"
                                Background="#47242A" BorderBrush="#75404A"
                                Click="CloseButton_Click" ToolTip="Zavřít" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Okraj musí zůstat volný pro ResizeBorderThickness. WebView2 je skutečné
                 dceřiné okno (HWND) a kdyby sahal až k hraně, spolkl by hit-test a okno by
                 se tažením za okraje nedalo zvětšit. -->
            <Grid Grid.Row="1" Margin="6,0,6,6">
                <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0B1019" />

                <!-- Než se vestavěný prohlížeč nastartuje, ať okno nesvítí prázdnotou. -->
                <Border x:Name="StatusOverlay" Background="#0B1019">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Spouštím vestavěný prohlížeč…"
                                   Foreground="{StaticResource SecondaryText}" FontSize="12"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   TextAlignment="Center" />
                        <Button x:Name="StatusAction" Content="Otevřít v systémovém prohlížeči"
                                Click="OpenInBrowserButton_Click" Margin="0,14,0,0" Padding="12,7" FontSize="11"
                                HorizontalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
