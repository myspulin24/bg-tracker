<Window x:Class="Tracker.Desktop.PatchNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Patch notes" Icon="Assets/bg-tracker.ico"
        Width="980" Height="820" MinWidth="420" MinHeight="320"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window}" Topmost="True" ShowInTaskbar="True">
    <!-- Vlastní chrome ve stylu overlaye, ale s nativním chováním okna: WindowChrome dá
         změnu velikosti ze všech stran, přichytávání k okrajům i tažení za titulní lištu. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Header}"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE8A5;" Style="{StaticResource GlyphStyle}" FontSize="14"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Patch notes" FontSize="12.5" FontWeight="Bold" FontFamily="{StaticResource Font.Display}" />
                        <TextBlock x:Name="AddressText" Foreground="{DynamicResource Brush.Text2}" FontSize="9.5"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Click="BackButton_Click"
                                ToolTip="Zpět" Width="30" Height="28" Margin="0,0,4,0">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource GlyphStyle}" FontSize="13" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Click="ReloadButton_Click"
                                ToolTip="Načíst znovu" Width="30" Height="28" Margin="0,0,4,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphStyle}" FontSize="13" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Click="OpenInBrowserButton_Click"
                                ToolTip="Otevřít v systémovém prohlížeči" Width="30" Height="28" Margin="0,0,12,0">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource GlyphStyle}" FontSize="13" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Width="30" Height="28"
                                Click="MinimizeButton_Click" ToolTip="Minimalizovat">
                            <TextBlock Text="&#xE921;" Style="{StaticResource GlyphStyle}" FontSize="11" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButtonStyle}" Width="30" Height="28" Margin="4,0,0,0"
                                Click="MaximizeButton_Click" ToolTip="Maximalizovat">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" Style="{StaticResource GlyphStyle}" FontSize="11" />
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseButtonStyle}" Width="30" Height="28" Margin="4,0,0,0"
                                Click="CloseButton_Click" ToolTip="Zavřít">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource GlyphStyle}" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Okraj musí zůstat volný pro ResizeBorderThickness. WebView2 je skutečné dceřiné
                 okno (HWND) a kdyby sahal až k hraně, spolkl by hit-test a okno by se tažením
                 za okraje nedalo zvětšit. -->
            <Grid Grid.Row="1" Margin="6,0,6,6">
                <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0D1117" />

                <!-- Než se vestavěný prohlížeč nastartuje, ať okno nesvítí prázdnotou. -->
                <Border x:Name="StatusOverlay" Background="{DynamicResource Brush.Window}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Spouštím vestavěný prohlížeč…"
                                   Foreground="{DynamicResource Brush.Text2}" FontSize="12"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   TextAlignment="Center" />
                        <Button x:Name="StatusAction" Content="Otevřít v systémovém prohlížeči"
                                Click="OpenInBrowserButton_Click" Margin="0,14,0,0" Padding="12,7" FontSize="11"
                                HorizontalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
